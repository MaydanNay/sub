{
  "name": "mini-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "optimize:assets": "node scripts/optimize-mascot-assets.mjs",
    "dev": "npm run optimize:assets && vite --port 5173",
    "build": "npm run optimize:assets && tsc -b && vite build && npm run build:prune-png && npm run build:verify-assets",
    "build:prune-png": "find dist/assets \\( -name '*.PNG' -o -name '*.png' \\) -delete 2>/dev/null || true",
    "build:verify-assets": "node scripts/verify-dist-assets.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@restart-clinic/shared": "*",
    "@telegram-apps/sdk-react": "^2.0.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "sharp": "^0.34.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  }
}
