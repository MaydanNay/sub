FROM node:20-alpine AS builder
WORKDIR /app

# Copy package.jsons
COPY package*.json ./
COPY backend/package*.json backend/
COPY mini-app/package*.json mini-app/
COPY dashboard/package*.json dashboard/
COPY shared/package*.json shared/

RUN npm install

# Copy source code
COPY shared shared
COPY mini-app mini-app
COPY dashboard dashboard

# Build mini-app
WORKDIR /app/mini-app
RUN npm run build

# Build dashboard
WORKDIR /app/dashboard
RUN npm run build

# Setup Nginx
FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/mini-app/dist /usr/share/nginx/html/mini-app
COPY --from=builder /app/dashboard/dist /usr/share/nginx/html/dashboard

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
